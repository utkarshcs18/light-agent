# Copy this file to .env and fill in your key.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional overrides:
# CLAUDE_MODEL=claude-sonnet-4-5
# LIGHT_CONNECTOR=mock   # "mock" (no hardware) or "kasa" (real bulbs)

# Kasa discovery (used by `npm run setup`), all optional:
# KASA_DISCOVERY_SECONDS=5        # how long to scan the LAN
# KASA_BROADCAST=192.168.1.255    # override if discovery finds nothing on your subnet
